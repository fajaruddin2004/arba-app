generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tb_user {
  id_user  Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String

  mahasiswa tb_mahasiswa?
  dosen     tb_dosen?
}

model tb_jurusan {
  id_jurusan   Int            @id @default(autoincrement())
  nama_jurusan String
  mahasiswa    tb_mahasiswa[]
  matkul       tb_mata_kuliah[]
}

model tb_semester {
  id_semester   Int            @id @default(autoincrement())
  nama_semester String
  mahasiswa     tb_mahasiswa[]
  matkul       tb_mata_kuliah[]
}

model tb_mahasiswa {
  nim             String      @id
  id_user         Int         @unique
  nama_mahasiswa  String
  id_jurusan      Int?
  id_semester     Int?
  jenis_kelamin   String?
  foto_profil     String?     @db.Text

  user     tb_user      @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  jurusan  tb_jurusan?  @relation(fields: [id_jurusan], references: [id_jurusan])
  semester tb_semester? @relation(fields: [id_semester], references: [id_semester])

  presensi tb_presensi[]
  evaluasi tb_evaluasi[]
}

model tb_dosen {
  nidn       String @id
  id_user    Int    @unique
  nama_dosen String
  foto_profil String? @db.Text

  user     tb_user         @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  presensi tb_presensi[]
  evaluasi tb_evaluasi[]
  sesi     tb_sesi_kelas[]
  matkul   tb_mata_kuliah[]
}

model tb_mata_kuliah {
  kode_mk String @id
  nama_mk String
  sks     Int
  nidn    String?
  hari    String?
  waktu       String?
  ruangan     String?
  id_jurusan  Int?
  id_semester Int?
  dosen       tb_dosen?    @relation(fields: [nidn], references: [nidn])
  jurusan     tb_jurusan?  @relation(fields: [id_jurusan], references: [id_jurusan])
  semester    tb_semester? @relation(fields: [id_semester], references: [id_semester])
  presensi    tb_presensi[]
}

model tb_ruangan {
  kode_ruangan String @id
  nama_ruangan String
  presensi     tb_presensi[]
}

model tb_koordinat_kampus {
  id_koordinat     Int    @id @default(autoincrement())
  latitude_kampus  String
  longitude_kampus String
  radius_meter     Int
}

model tb_sesi_kelas {
  id_sesi    Int       @id @default(autoincrement())
  nidn       String
  nama_mk    String
  waktu_buka DateTime  @default(now())
  waktu_tutup DateTime?
  status     String    @default("AKTIF")
  qr_token   String    @unique

  dosen    tb_dosen      @relation(fields: [nidn], references: [nidn])
  presensi tb_presensi[]
}

model tb_presensi {
  id_presensi Int      @id @default(autoincrement())
  nim         String
  nidn        String
  id_sesi     Int?
  kode_mk     String?
  kode_ruangan String?
  waktu_absen DateTime @default(now())
  lat_mhs     String
  long_mhs    String
  status      String

  mahasiswa tb_mahasiswa   @relation(fields: [nim], references: [nim])
  dosen     tb_dosen       @relation(fields: [nidn], references: [nidn])
  sesi      tb_sesi_kelas? @relation(fields: [id_sesi], references: [id_sesi])
  mata_kuliah tb_mata_kuliah? @relation(fields: [kode_mk], references: [kode_mk])
  ruangan     tb_ruangan?     @relation(fields: [kode_ruangan], references: [kode_ruangan])
}

model tb_kuesioner {
  id_kuesioner Int    @id @default(autoincrement())
  pertanyaan   String
  status_aktif String

  evaluasi tb_evaluasi[]
}

model tb_evaluasi {
  id_hasil     Int    @id @default(autoincrement())
  id_kuesioner Int
  nim          String
  nidn         String
  skor_nilai   Int

  kuesioner tb_kuesioner @relation(fields: [id_kuesioner], references: [id_kuesioner])
  mahasiswa tb_mahasiswa @relation(fields: [nim], references: [nim])
  dosen     tb_dosen     @relation(fields: [nidn], references: [nidn])
}
